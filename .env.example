# ============================================================================
# FINTRACK — VARIÁVEIS DE AMBIENTE
# ============================================================================
#
# Copie este arquivo para ".env" antes de executar o projeto:
#
# cp .env.example .env
#
# Nunca envie o arquivo ".env" com valores reais para o GitHub.
# Consulte "docs/ambientes.md" para instruções completas de configuração.
#
# ============================================================================


# ============================================================================
# AUTH.JS
# ============================================================================
#
# Segredo utilizado pela autenticação do projeto.
#
# Gere um segredo seguro com:
#
# npx auth secret
#
AUTH_SECRET=COLE_SEU_AUTH_SECRET_AQUI


# URL base da aplicação durante o desenvolvimento local.
NEXTAUTH_URL=http://localhost:3000


# ============================================================================
# BANCO DE DADOS — TURSO / libSQL
# ============================================================================
#
# URL do banco de dados.
#
# Exemplo:
# libsql://seu-banco.turso.io
#
DATABASE_URL=libsql://URL-DO-SEU-BANCO.turso.io


# Token de autenticação do banco remoto.
#
# Necessário quando DATABASE_URL aponta para um banco remoto.
# Nunca compartilhe ou envie este token para o GitHub.
#
DATABASE_AUTH_TOKEN=COLE_SEU_TOKEN_AQUI