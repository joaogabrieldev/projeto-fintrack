# ============================================================================
# GUIA RÁPIDO (WINDOWS + AUTH.JS + TURSO)
# ============================================================================
# 0) Pré-requisitos:
#    - Node.js LTS instalado
#    - pnpm instalado (ou npm/yarn/bun)
#
# INSTALAÇÃO DA CLI DO TURSO
#   Linux / macOS:
#     curl -sSfL https://get.tur.so/install.sh | bash
#   Windows (PowerShell como administrador):
#     winget install turso
#   Após instalar no Linux/macOS (ou WSL com install script), inclua o Turso no PATH
#   da sessão atual (ou adicione a mesma linha ao ~/.bashrc / ~/.zshrc para ficar permanente):
#     export PATH="~/.turso:$PATH"
#
# 2) Validar instalação:
#      turso --version
#
# 3) Criar conta/login no Turso:
#      turso auth signup                  (primeira vez)
#      turso auth login                   (se já tiver conta)
#      turso auth login --headless        (opcional, sem navegador)
#
# 4) Criar banco:
#      turso db create fintrack
#
# 5) Obter URL do banco (usar em DATABASE_URL):
#      turso db show fintrack --url
#
# 6) Criar token do banco (usar em DATABASE_AUTH_TOKEN):
#      turso db tokens create fintrack
#
# 7) Gerar segredo do Auth.js (usar em AUTH_SECRET):
#      npx auth secret
#
# 8) Aplicar schema/migrations no banco:
#      pnpm db:push
#
# 9) Rodar projeto:
#      pnpm dev
#

# ============================================================================
# AUTH.JS
# ============================================================================
# Obrigatório: segredo gerado com "npx auth secret"
AUTH_SECRET=SEGREDO-DO-SEU-AUTH

# URL base da aplicação em desenvolvimento local
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# TURSO (libSQL)
# ============================================================================
# URL retornada por: turso db show fintrack --url
DATABASE_URL=libsql://URL-DA-SUA-DATABASE.turso.io

# Token retornado por: turso db tokens create fintrack
DATABASE_AUTH_TOKEN=TOKEN-DO-SEU-AUTH
